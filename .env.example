# Environment variables for the Kommissary 2.0 site.
#
# Locally: copy this to .env.local (gitignored) and fill in what you need.
# On Hostinger: add them in hPanel, in the Node.js app's Environment variables.
# See HOSTING.md for which ones each site (staging / live) needs.

# --- Sanity (required everywhere) ----------------------------------------------------
# Not secret: they're in every page's JavaScript.
NEXT_PUBLIC_SANITY_PROJECT_ID=9axriqng
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# --- Staging only --------------------------------------------------------------------
# Asks for this password (any username) before showing the site. Has no effect on
# kommissary.com, so it's safe to leave set by mistake. Never set it on the live site.
STAGING_PASSWORD=

# --- Instagram reels on the homepage phones (needed on the LIVE site) -----------------
# Decrypts the Instagram token stored in Sanity. MUST be identical everywhere it's set:
# a different value can't read the stored token (recoverable only by re-connecting
# Instagram). 64 hex characters.
INSTAGRAM_TOKEN_KEY=
# Lets the site save the refreshed Instagram token to Sanity. Sanity -> API -> Tokens,
# Editor permission.
SANITY_WRITE_TOKEN=
# Guards the weekly token refresh (/api/instagram/refresh). Any long random string; the
# cron job sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# The originally issued token. Only a fallback until the first refresh is stored.
INSTAGRAM_ACCESS_TOKEN=
# For re-connecting Instagram (/api/instagram/connect). The redirect URI must also be
# listed in the Meta app's settings. Defaults to the old Vercel address if unset; set it
# to https://kommissary.com/api/instagram/callback at launch.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# --- Ask Kai chat ----------------------------------------------------------------------
# Google Gemini API key. Without it, Kai shows its "recharging" state.
GEMINI_API_KEY=

# --- Not used by the site --------------------------------------------------------------
# Only the one-off scripts/migrate-body-to-sections.mjs reads this, and that migration has
# already run. Leave unset.
# SANITY_API_WRITE_TOKEN=
